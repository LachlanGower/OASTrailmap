{
  "name": "oas-trailmap",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first OAS Trailmap; standalone Vue application",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check:baseline": "node scripts/check-migration-baseline.cjs && node scripts/check-migration-contracts.cjs",
    "check:dist": "node scripts/check-built-legacy.cjs",
    "test": "npm run check:baseline && npm run test:domain",
    "test:domain": "tsc -p tsconfig.domain-tests.json && node --test tests/unit/*.test.cjs",
    "test:vue": "node tests/e2e/standalone-vue.cjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "vue": "^3.5.44",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.18.1",
    "@vitejs/plugin-vue": "6.0.1",
    "playwright": "1.56.1",
    "typescript": "5.9.2",
    "vite": "^7.3.7",
    "vue-tsc": "3.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
