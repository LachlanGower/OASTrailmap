{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": "src",
    "outDir": ".phase3-test-dist"
  },
  "include": ["src/domain/**/*.ts", "src/services/**/*.ts", "src/features/application-requirements/catalogue.ts", "src/features/trailmap/map-model.ts", "src/features/workbook/workbook-parser.ts", "src/features/tree/tree-view-model.ts", "src/features/tree/tree-editor-model.ts", "src/features/tree/admin-types.ts"],
  "exclude": ["src/components", "node_modules", "dist"]
}
